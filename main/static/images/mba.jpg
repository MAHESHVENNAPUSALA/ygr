ock; position: absolute; top: 11px; transform: translateZ(0px); }

:root { --sharp-edge-top-shadow: 0 1px 0 var(--border-sharp); --sharp-edge-=
top-shadow-placeholder: 0 1px 0 transparent; --sharp-edge-bottom-shadow: 0 =
-1px 0 var(--border-sharp); --sharp-edge-bottom-shadow-placeholder: 0 -1px =
0 transparent; }

@keyframes add-top-shadow {=20
  0% { box-shadow: var(--sharp-edge-top-shadow-placeholder); }
  0.1%, 100% { box-shadow: var(--sharp-edge-top-shadow); }
}

@keyframes add-bottom-shadow {=20
  0%, 99.9% { box-shadow: var(--sharp-edge-bottom-shadow); }
  100% { box-shadow: var(--sharp-edge-bottom-shadow-placeholder); }
}

.sharp-edge-on-scroll-start { box-shadow: rgba(0, 0, 0, 0) 0px 1px; }

@supports (animation-timeline:--agi) {
  .sharp-edge-on-scroll-start { animation-duration: 1ms; animation-timing-f=
unction: linear; animation-delay: 0s; animation-iteration-count: 1; animati=
on-direction: normal; animation-fill-mode: both; animation-play-state: runn=
ing; animation-name: add-top-shadow; animation-timeline: auto; animation-ra=
nge: 0px 1px; }
}

.sharp-edge-on-scroll-end { box-shadow: rgba(0, 0, 0, 0) 0px -1px; }

.sharp-edge-on-scroll-start, .sharp-edge-on-scroll-end, .sharp-edge-on-scro=
ll-start { animation-timeline: scroll(); }

@keyframes shimmer-skeleton {=20
  0% { background-position: 100% center; }
  100% { background-position: 0% center; }
}

@supports selector(:has(*)) {
  .result-streaming:not(.streaming-animation) > :is(ul, ol):last-child > li=
:last-child > :is(ul, ol):last-child > li:last-child::after, .result-stream=
ing:not(.streaming-animation) > :is(ul, ol):last-child > li:last-child > :i=
s(ul, ol):last-child > li:last-child > :is(ul, ol):last-child > li:last-chi=
ld::after, .result-streaming:not(.streaming-animation) > :is(ul, ol):last-c=
hild > li:last-child:not(:has(* > li))::after { content: "=E2=97=8F"; verti=
cal-align: baseline; margin-inline-start: 0.25rem; font-family: Circle, sys=
tem-ui, sans-serif; line-height: normal; }
}

@supports not selector(:has(*)) {
  .result-streaming > ol:last-child > li:last-child::after, .result-streami=
ng > ul:last-child > li:last-child::after { content: "=E2=97=8F"; vertical-=
align: baseline; margin-inline-start: 0.25rem; font-family: Circle, system-=
ui, sans-serif; line-height: normal; }
}

.result-streaming .katex-error { display: none; }

@keyframes pulse-dot {=20
  0% { opacity: 0.1; scale: 0.7; }
  50% { transform: scale(var(--pulse-scale,1.3)); opacity: 1; }
  100% { opacity: 0; transform: scale(0.7); }
}

@keyframes float-sidebar-in {=20
  0% { opacity: 0; translate: -60%; }
  70% { opacity: 1; }
  100% { translate: 0px; }
}

@keyframes float-sidebar-out {=20
  0% { translate: 0px; }
  30% { opacity: 1; }
  100% { opacity: 0; translate: -60%; }
}

@media (prefers-reduced-motion: no-preference) {
  .pulsing-dot { opacity: 0; animation-duration: ; animation-timing-functio=
n: ; animation-iteration-count: ; animation-direction: ; animation-fill-mod=
e: ; animation-play-state: ; animation-name: ; animation-timeline: ; animat=
ion-range-start: ; animation-range-end: ; animation-delay: 0.3s; }
}

@keyframes pulseSize {=20
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.25); }
}

@keyframes toast-open {=20
  0% { opacity: 0; transform: translateY(-100%); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes toast-close {=20
  0% { opacity: 1; }
  100% { opacity: 0; }
}

.toast-root { flex-direction: column; align-items: center; height: 0px; tra=
nsition: 0.24s cubic-bezier(0, 0, 0.2, 1); display: flex; }

.toast-root[data-state=3D"entering"] { animation: 0.24s cubic-bezier(0.175,=
 0.885, 0.32, 1) 0s 1 normal both running toast-open; }

.toast-root[data-state=3D"exiting"] { animation: 0.12s cubic-bezier(0.4, 0,=
 1, 1) 0s 1 normal both running toast-close; }

.toast-root .alert-root { pointer-events: all; flex-shrink: 0; box-shadow: =
rgba(67, 90, 111, 0.3) 0px 0px 1px, rgba(67, 90, 111, 0.3) 0px 5px 8px -4px=
; }

.title { font-feature-settings: normal; font-variation-settings: normal; fo=
nt-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, "Helvetica Neue", =
Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol"=
, "Noto Color Emoji"; }

.images-app { --images-app-active: 1; }

@media not all and (min-width: 48rem) {
  .images-app [data-scroll-root] { margin-top: calc(var(--header-height) * =
-1); mask-image: linear-gradient(to bottom,transparent 0px,transparent var(=
--header-height),black var(--header-height)); mask-clip: content-box; }
}

.images-app.no-auth #page-header { width: 100%; box-shadow: var(--sharp-edg=
e-top-shadow-placeholder); }

.images-app.no-auth [data-scroll-root] { margin-top: calc(var(--header-heig=
ht) * -1); mask-image: linear-gradient(to bottom,transparent 0px,transparen=
t var(--header-height),black var(--header-height)); mask-clip: content-box;=
 }

.images-app.no-auth.scrolled-from-start #page-header { width: 100%; box-sha=
dow: var(--sharp-edge-top-shadow); }

.icon-shimmer { background-repeat: no-repeat; animation: 5s cubic-bezier(0.=
2, 0.44, 0.38, 1.02) 0s infinite normal none running icon-shimmer; mask: li=
near-gradient(80deg, currentcolor 30%, rgba(0, 0, 0, 0.333), currentcolor 7=
0%) 100% center / 300% 100%; }

@keyframes icon-shimmer {=20
  0% { mask-position: 100% center; }
  20% { mask-position: 0px center; }
  100% { mask-position: 0px center; }
}

@keyframes loading-results-shimmer {=20
  0% { background-position: -1000px 0px; }
  100% { background-position: 1000px 0px; }
}

@keyframes scalePulse {=20
  0%, 100% { filter: blur(); transform: scale(1); }
  50% { filter: blur(8px); transform: scale(1.1); }
}

.bg-scale-pulse { transform-origin: 50% center; animation: 3.5s ease-in-out=
 0s infinite normal none running scalePulse; }

@keyframes diagonalSweep {=20
  0% { transform: translate(-100%, -100%); }
  100% { transform: translate(100%, 100%); }
}

.diagonal-sweep-gradient { background-image: linear-gradient(135deg, rgba(2=
55, 255, 255, 0) 46%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0) =
54%); animation: 4s ease-out 0s infinite normal none running diagonalSweep;=
 }

