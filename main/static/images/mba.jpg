Content-Transfer-Encoding: quoted-printable
Content-Location: https://chatgpt.com/cdn/assets/code-block-viewer-bb2wmqiy.css

@charset "utf-8";

.q9tKkq_viewer { background-color: var(--codemirror-bg,transparent); border=
-width: medium; border-style: none; border-color: currentcolor; border-imag=
e: initial; border-radius: 0px; font-size: 14px; overflow: hidden; }

.q9tKkq_viewer .cm-scroller { scroll-behavior: auto; overscroll-behavior-x:=
 contain; align-items: stretch; display: flex; overflow-x: auto; }

.q9tKkq_viewer .cm-content { white-space: pre; min-width: max-content; padd=
ing: 0 calc(var(--spacing) * 4) calc(var(--spacing) * 3); flex: 1 1 0%; lin=
e-height: 20px; font-family: var(--font-mono) !important; }

@media (min-width: 768px) {
  .q9tKkq_viewer .cm-content { padding: 0 calc(var(--spacing) * 5) calc(var=
(--spacing) * 3); }
}

.q9tKkq_viewer .cm-content { color: var(--text-primary); }

.q9tKkq_viewer .cm-content ::selection { background-color: var(--theme-user=
-selection-bg); }

.q9tKkq_viewer.q9tKkq_wrapLines .cm-scroller { overflow-x: hidden; }

.q9tKkq_viewer.q9tKkq_wrapLines .cm-content { white-space: pre-wrap; overfl=
ow-wrap: anywhere; min-width: 0px; }

.fullscreen .q9tKkq_viewer .cm-content { padding-top: calc(var(--spacing) *=
 3); }

.q9tKkq_readonly { cursor: text; }
