  @keyframes scroll-shadow-reveal {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}
  @keyframes scroll-shadow-detect {=20
  0%, 100% { --can-scroll: ; }
}
  .horizontal-scroll-shadow-container, .vertical-scroll-shadow-container { =
