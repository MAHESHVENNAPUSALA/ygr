  .horizontal-scroll-shadow-container::before, .vertical-scroll-shadow-cont=
ainer::before { animation-range: 1em 2em; }
  .horizontal-scroll-shadow-container::after, .vertical-scroll-shadow-conta=
iner::after { animation-direction: reverse; animation-range: calc(100% - 2e=
